!Conf Switch Core CC-P2-SW-C-1
enable 
configure terminal

!Parametros basicos
hostname C3-R-EDGE
ip domain-name equipo5.edu
banner motd #Acceso restringido - EDGE#
enable secret class
service password-encryption

!Console 
line console 0
password cisco
login 
exit

!SSH
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 4
login local
transport input ssh
exit

! Enlace al punto hacia C3-R-LOCAL
interface serial0/1/0
description Enlace al campus 1
ip address 172.28.51.22 255.255.255.252
no shutdown
exit

!Enlace punto a punto a proveedor ISP-2
interface serial0/1/1
description Enlace al proveedor ISP-2
ip address 209.165.200.193 255.255.255.224
no shutdown
exit

!Ruteo estatico
ip route 0.0.0.0 0.0.0.0 209.165.200.222

!conexion tunel a campus 1
interface tunnel 0
ip address 192.168.0.1 255.255.255.252
tunnel source serial0/1/1
tunnel destination 209.165.200.254
tunnel mode gre ip

!Configuracion de ospf
router ospf 5
router-id 3.3.3.3
log-adjacency-changes
auto-cost reference-bandwidth 10000
network 172.28.51.20 0.0.0.3 area 0
network 192.168.0.0 0.0.0.3 area 0

exit