!conf Switch de distribucion
enable 
configure terminal

!parametros basicos
hostname EC-P3-SW-D-1
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 3
!name Administrativos
!vlan 4
!name Directivos
!vlan 5
!name Soporte_TI
!vlan 6
!name Estudiantes
!vlan 7
!name Servidores
!vlan 8
!name Porfesores
!vlan 99
!name Admin_TI
!exit

!Asignar puertos de acceso (N/A)

!puertos troncales
interface range g1/0/1-2
channel-group 1 mode active

interface range g1/0/11-12
channel-group 11 mode active

interface range g1/0/13-14
channel-group 12 mode active

interface range g1/0/15-16
channel-group 13 mode active

interface range g1/0/17-18
channel-group 14 mode active

interface range g1/0/19-20
channel-group 15 mode active

interface range g1/0/21-22
channel-group 16 mode active

interface range port-channel 1, 11, 12, 13, 14, 15, 16
switchport mode trunk
exit

spanning-tree mode rapid-pvst
spanning-tree vlan 3-8,99 root secondary 

!Configuracion vtp
vtp version 1
vtp domain Edificio_Central
vtp password cisco
vtp mode server

!vlans
vlan 3
name Administrativos
vlan 4
name Directivos
vlan 5
name Soporte_TI
vlan 6
name Estudiantes
vlan 7
name Servidores
vlan 8
name Porfesores
vlan 99
name Admin_TI
exit

!SVI de administracion
interface vlan 99
ip address 172.28.36.248 255.255.255.128
no shutdown
exit
ip default-gateway 172.28.36.129

