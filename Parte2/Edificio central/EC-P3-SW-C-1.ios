!conf Switch Core
enable 
configure terminal

!parametros basicos
hostname EC-P3-SW-C-1
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 3
!name Administrativos
!vlan 4
!name Directivos
!vlan 5
!name Soporte_TI
!vlan 6
!name Estudiantes
!vlan 7
!name Servidores
!vlan 8
!name Porfesores
!vlan 11
!name Laboratorios_AE
!vlan 12
!!name Camaras_AE
!!vlan 13
!!name Jefatura_AE
!!vlan 14
!!name Administrativos_AE
!!vlan 21
!!name Laboratorios_||
!!vlan 22
!!name Camaras_||
!!vlan 23
!!name Jefatura_||
!!vlan 24
!!name Administrativo_||
!!vlan 31
!!name Laboratorios_IB
!!vlan 32
!!name Camaras_IB
!!vlan 33
!!name Jefatura_IB
!!vlan 34
!!name Administrativos_IB
!!vlan 41
!!name Salas_lectura_BB
!!vlan 42
!!name Camaras_BB
!!vlan 43
!!name Jefatura_BB
!!vlan 44
!!name Control_BB
!!vlan 99
!!name Admin_TI
!exit



!Asignar puertos de acceso (N/A)

!Asignacion de etherchannel
!Asignacion de etherchannel 1 hacia el switch EC-P3-SW-D-1
interface range g1/0/1-2
channel-group 1 mode active

!Asignacion de etherchannel 2 hacia el switch AE-P2-SW-D-1
interface range g1/0/3-4
channel-group 2 mode active

!Asignacion de etherchannel 3 hacia el switch II-P2-SW-D-1
interface range g1/0/5-6
channel-group 3 mode active

!Asignacion de etherchannel 4 hacia el switch IB-P2-SW-D-1
interface range g1/0/7-8
channel-group 4 mode active

!Asignacion de etherchannel 5 hacia el switch B-P2-SW-D-1
interface range g1/0/9-10
channel-group 5 mode active

interface range port-channel 1-5
switchport mode trunk
exit

!Condifuracion spanning-tree
spanning-tree mode rapid-pvst
spanning-tree vlan 3-8,11-14,21-24,31-34,41-44,99 root primary 

!configuracion vtp version 2
vtp version 2
vtp domain equipo5
vtp mode transparent 

!vlans
vlan 3
name Administrativos
vlan 4
name Directivos
vlan 5
name Soporte_TI
vlan 6
name Estudiantes
vlan 7
name Servidores
vlan 8
name Porfesores
vlan 11
name Laboratorios_AE
vlan 12
name Camaras_AE
vlan 13
name Jefatura_AE
vlan 14
name Administrativos_AE
vlan 21
name Laboratorios_||
vlan 22
name Camaras_||
vlan 23
name Jefatura_||
vlan 24
name Administrativo_||
vlan 31
name Laboratorios_IB
vlan 32
name Camaras_IB
vlan 33
name Jefatura_IB
vlan 34
name Administrativos_IB
vlan 41
name Salas_lectura_BB
vlan 42
name Camaras_BB
vlan 43
name Jefatura_BB
vlan 44
name Control_BB
vlan 99
name Admin_TI
exit

!SVI de administracion
ip routing
interface VLAN 3
ip address 172.28.36.126 255.255.255.128
no shutdown
interface VLAN 4
ip address 172.28.39.30 255.255.255.224
no shutdown
interface VLAN 5
ip address 172.28.39.94 255.255.255.224
no shutdown
interface VLAN 6
ip address 172.28.31.254 255.255.224.0
no shutdown
interface VLAN 7
ip address 172.28.38.254 255.255.255.192
no shutdown
interface VLAN 8
ip address 172.28.35.254 255.255.252.0
no shutdown
interface VLAN 11
ip address 172.28.37.126 255.255.255.128
no shutdown
interface VLAN 12
ip address 172.28.39.126 255.255.255.224
no shutdown
interface VLAN 13
ip address 172.28.39.158 255.255.255.224
no shutdown
interface VLAN 14
ip address 172.28.39.190 255.255.255.224
no shutdown
interface VLAN 21
ip address 172.28.37.254 255.255.255.128
no shutdown
interface VLAN 22
ip address 172.28.39.222 255.255.255.224
no shutdown
interface VLAN 23
ip address 172.28.39.254 255.255.255.224
no shutdown
interface VLAN 24
ip address 172.28.40.30 255.255.255.224
no shutdown
interface VLAN 31
ip address 172.28.38.190 255.255.255.192
no shutdown
interface VLAN 32
ip address 172.28.40.46 255.255.255.240
no shutdown
interface VLAN 33
ip address 172.28.40.62 255.255.255.240
no shutdown
interface VLAN 34
ip address 172.28.40.78 255.255.255.240
no shutdown
interface VLAN 41
ip address 172.28.38.126 255.255.255.128
no shutdown
interface VLAN 42
ip address 172.28.40.94 255.255.255.240
no shutdown
interface VLAN 43
ip address 172.28.40.110 255.255.255.240
no shutdown
interface VLAN 44
ip address 172.28.39.62 255.255.255.224
no shutdown
interface VLAN 99
ip address 172.28.36.129 255.255.255.128
no shutdown

!Configuracion de dhcp
ip dhcp excluded-address 172.28.0.1
ip dhcp excluded-address 172.28.32.1
ip dhcp excluded-address 172.28.39.1
ip dhcp excluded-address 172.28.39.193
ip dhcp excluded-address 172.28.39.97
ip dhcp excluded-address 172.28.40.33
ip dhcp excluded-address 172.28.40.81


!configuracion pool de estudiante
ip dhcp pool estudiantes
network 172.28.0.0 255.255.224.0
default-router 172.28.0.1
dns-server 172.28.38.193
domain-name estudiantes.equipo5.edu

!Configuracion de pool de profesores
ip dhcp pool profesores
network 172.28.32.0 255.255.252.0
default-router 172.28.32.1
dns-server 172.28.38.193
domain-name profesores.equipo5.edu

!Configuracion de pool de directivos
ip dhcp pool directivos
network 172.28.39.0 255.255.255.224
default-router 172.28.39.1
dns-server 172.28.38.193
domain-name directivos.equipo5.edu

!Configuracion de pool de camaras industrial
ip dhcp pool camaras_II
network 172.28.39.192 255.255.255.224
default-router 172.28.39.193
dns-server 172.28.38.193
domain-name camaras_II.equipo5.edu

!-----------------------------------------------------------------
!Configuracion de pool de camaras administracion de emppresas
ip dhcp pool camaras_AE
 network 172.28.39.96 255.255.255.224
 default-router 172.28.39.97
 dns-server 172.28.38.193
 domain-name camaras_AE.equipo5.edu

!Configuracion de pool de camaras biblioteca
ip dhcp pool camaras_BB
 network 172.28.40.80 255.255.255.240
 default-router 172.28.40.81
 dns-server 172.28.38.193
 domain-name camaras_BB.equipo5.edu

!Configuracion de pool de camaras bioquimica
ip dhcp pool camaras_IB
 network 172.28.40.32 255.255.255.240
 default-router 172.28.40.33
 dns-server 172.28.38.193
 domain-name camaras_IB.equipo5.edu

exit

