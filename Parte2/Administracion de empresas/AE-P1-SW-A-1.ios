!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname EC-P1-SW-A-1
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 5
!name Soporte_TI
!vlan 6
!name Estudiantes
!vlan 99
!name Admin_TI
!exit

!Asignar puertos de acceso
interface range f0/1-12
switchport mode access
switchport access vlan 11

interface range f0/13-24
switchport mode access
switchport access vlan 12

interface range g 0/1-2
channel-group 1 mode active

interface range port-channel 1
switchport mode trunk
exit

!SVI de administracion
interface vlan 99
ip address 172.28.36.247 255.255.255.128
no shutdown
exit
ip default-gateway 172.28.36.129
end
!Guardar configuracion
copy running-config startup-config