!conf Switch de distribucion
enable 
configure terminal

!parametros basicos
hostname IB-P2-SW-D-1
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!!vlans
!vlan 31
!name Laboratorios_IB
!vlan 32
!name Camaras_IB
!vlan 33
!name Jefatura_IB
!vlan 34
!name Administrativos_IB
!vlan 99
!name Admin_TI
!exit

!Asignar puertos de acceso (N/A)

!puertos troncales
interface range g1/0/1-2
channel-group 1 mode active

interface range g1/0/11-12
channel-group 11 mode active

interface range g1/0/13-14
channel-group 12 mode active

interface range g1/0/15-16
channel-group 13 mode active

interface range g1/0/17-18
channel-group 14 mode active


interface range port-channel 1, 11, 12, 13, 14
switchport mode trunk
exit

!SVI de administracion
interface vlan 99
ip address 172.28.36.238 255.255.255.128
no shutdown
exit
ip default-gateway 172.28.36.129


