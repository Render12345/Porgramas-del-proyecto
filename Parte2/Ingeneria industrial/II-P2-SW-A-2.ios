!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname II-P2-SW-D-1
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 21
!name Laboratorios_||
!vlan 24
!name Administrativo_||
!vlan 99
!name Admin_TI
!exit

!Asignar puertos de acceso
interface range f0/1-12
switchport mode access
switchport access vlan 21

interface range f0/13-24
switchport mode access
switchport access vlan 24

interface range g 0/1-2
channel-group 4 mode active

interface range port-channel 4
switchport mode trunk
exit

spanning-tree mode rapid-pvst
interface range f0/1-24
spanning-tree portfast
spanning-tree bpduguard enable

!Configuracion vtp
vtp version 1
vtp domain Ingenieria_industrial
vtp password cisco
vtp mode client

!SVI de administracion
interface vlan 99
ip address 172.28.36.239 255.255.255.128
no shutdown
exit
ip default-gateway 172.28.36.129
end
!Guardar configuracion
copy running-config startup-config