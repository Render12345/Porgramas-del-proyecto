enable
configure terminal

! Interfaz SVI para gestión
interface vlan 1
 ip address 192.168.1.157 255.255.255.240
 no shutdown
 exit

! Gateway predeterminado para comunicación entre redes
ip default-gateway 192.168.1.158

! Configuración de Telnet en la línea VTY
line vty 0 15
 password Cisco_CCNA7
 login
 transport input telnet
 exit

end
write memory

interface g0/0/1
no shutdown 
interface g0/0/1.40
description "Gateway for VLAN40"
encapsulation dot1q 40
ip address 10.0.40.1 255.255.255.0
exit
interface g0/0/1.50
description "Gateway for VLAN50"
encapsulation dot1q 50
ip address 10.0.50.1 255.255.255.0
exit
interface g0/0/1.60
description "Gateway for VLAN60"
encapsulation dot1q 60
ip address 10.0.60.1 255.255.255.0
exit
interface g0/0/1.99
description "Gateway for VLAN99"
encapsulation dot1q 99 native
ip address 10.0.99.17 255.255.255.240
exit