enable
configure terminal

! Interfaz SVI para gestión
interface vlan 1
 ip address 192.168.1.157 255.255.255.240
 no shutdown
 exit

! Gateway predeterminado para comunicación entre redes
ip default-gateway 192.168.1.158

! Configuración de Telnet en la línea VTY
line vty 0 15
 password Cisco_CCNA7
 login
 transport input telnet
 exit

end
write memory

interface port-channel 2
switchport mode trunk 
switchport nonegotiate
exit

interface port-channel 3
switchport mode trunk 
switchport nonegotiate
exit