enable
configure terminal

! Nombre de host
hostname Town-Hall

! Seguridad de contraseñas y accesos
security passwords min-length 10
enable secret Cisco_CCNA7
service password-encryption

! Cartel de advertencia
banner motd # Acceso no autorizado prohibido. #

! Dominio, usuario SSH y clave RSA de 1024 bits
ip domain-name cisco.com
username netadmin privilege 15 secret Cisco_CCNA7
crypto key generate rsa
1024

! Asegurar líneas de acceso (SSH únicamente)
line console 0
 password Cisco_CCNA7
 login
 exit

line vty 0 4
 transport input ssh
 login local
 exit

! Habilitar enrutamiento IPv6
ipv6 unicast-routing

! Interfaz G0/0 (Dpto. TI)
interface GigabitEthernet0/0
 description Conexion a LAN IT Department
 ip address 192.168.1.126 255.255.255.224
 ipv6 address 2001:db8:acad:a::1/64
 ipv6 address fe80::1 link-local
 no shutdown
 exit

! Interfaz G0/1 (Administración)
interface GigabitEthernet0/1
 description Conexion a LAN Administration
 ip address 192.168.1.158 255.255.255.240
 ipv6 address 2001:db8:acad:b::1/64
 ipv6 address fe80::1 link-local
 no shutdown
 exit

end
write memory